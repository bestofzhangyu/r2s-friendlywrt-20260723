#!/bin/sh
# ============================================================
#  uci-defaults: auto-configure multi-NIC network
#  4 NICs: 1 WAN (PPPoE) + 3 LAN (bridge)
#
#  NOTE: This script writes /etc/config/network directly instead
#  of using uci commands, because OpenWrt 22.03+ bridge devices
#  are anonymous sections that cannot be deleted by name.
# ============================================================

# Get all physical NICs (eth0, eth1, enp0sX, etc.), sorted
nics=$(ls /sys/class/net/ 2>/dev/null | grep -E '^(eth|enp|ens|eno)[0-9]+$' | sort)
nic_count=$(echo "$nics" | grep -c .)

# Need at least 2 NICs to configure
[ "$nic_count" -lt 2 ] && exit 0

wan_if=$(echo "$nics" | head -1)

echo "[network-config] Found $nic_count NICs: $(echo $nics | tr '\n' ' ')"
echo "[network-config] WAN = $wan_if"

# === Write /etc/config/network directly (most reliable) ===
cat > /etc/config/network << NETEOF

config interface 'loopback'
    option device 'lo'
    option proto 'static'
    option ipaddr '127.0.0.1'
    option netmask '255.0.0.0'

config globals 'globals'
    option ula_prefix 'fd00::/48'

config device
    option name 'br-lan'
    option type 'bridge'
NETEOF

# Add LAN ports to bridge (all NICs except WAN)
for nic in $(echo "$nics" | tail -n +2); do
    echo "    list ports '$nic'" >> /etc/config/network
    echo "[network-config] LAN bridge add port: $nic"
done

cat >> /etc/config/network << NETEOF

config interface 'lan'
    option device 'br-lan'
    option proto 'static'
    option ipaddr '192.168.100.1'
    option netmask '255.255.255.0'
    option ip6assign '60'

config interface 'wan'
    option device '$wan_if'
    option proto 'pppoe'
    option username ''
    option password ''
    option ipv6 'auto'

config interface 'wan6'
    option device '@wan'
    option proto 'dhcpv6'
NETEOF

echo "[network-config] /etc/config/network written"
cat /etc/config/network

# === DHCP configuration ===
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q commit dhcp

echo "[network-config] Done: LAN=192.168.100.1, WAN=$wan_if(PPPoE)"
echo "[network-config] PPPoE username/password needed in LuCI: Network -> Interfaces -> WAN"

exit 0
